# Example rclone remote for off-site backups (mounted read-only into the backup service).
# Copy to deploy/rclone.conf, fill in credentials, set RCLONE_CONFIG_FILE=./rclone.conf and
# RCLONE_REMOTE=offsite:termolink-backups in deploy/.env. Any rclone backend works (B2, S3, SFTP…).
[offsite]
type = s3
provider = Other
access_key_id = CHANGE_ME
secret_access_key = CHANGE_ME
endpoint = https://s3.example.com
acl = private
