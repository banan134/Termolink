# Termolink — environment. Copy to deploy/.env (never commit .env).
# Values below are safe defaults for local development only.
# Note: Compose does not strip inline comments — keep comments on their own lines.

# --- Django (DJANGO_ENV: dev | prod) ---
DJANGO_ENV=dev
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_LOG_LEVEL=INFO

# --- Database (db service) ---
POSTGRES_USER=termolink
POSTGRES_PASSWORD=termolink
POSTGRES_DB=termolink
# Owner role (migrations). The app itself connects as DB_APP_USER (no BYPASSRLS) — docs/03.
DATABASE_URL=postgres://termolink:termolink@db:5432/termolink
DB_APP_USER=termolink_app
DB_APP_PASSWORD=termolink_app

# --- Dev-only ports and helpers ---
# Change DEV_HTTP_PORT / DEV_DB_PORT if 8080 / 5432 are taken on your machine.
DEV_HTTP_PORT=8080
DEV_DB_PORT=5432
# Password for every demo account created by `make seed` (dev only, >= 12 chars).
DEV_ADMIN_PASSWORD=demo-password-1234
# Keep the shared Viessmann budget safe in dev.
DEV_POLL_INTERVAL_S=600
# File watching on Windows/macOS bind mounts (1 = polling).
VITE_USE_POLLING=1

# --- Secrets ---
# 32 B base64: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# DEV-ONLY value below — generate your own for staging/prod and keep it out of the DB backup.
TOKEN_MASTER_KEY=ZGV2LW9ubHktZGV2LW9ubHktZGV2LW9ubHktZGV2ISE=

# --- Viessmann ---
VIESSMANN_CLIENT_ID=
VIESSMANN_API_BASE=https://api.viessmann-climatesolutions.com/iot/v1
VIESSMANN_IAM_BASE=https://iam.viessmann-climatesolutions.com/idp/v3
# 1 = adapter reads fixtures instead of the API (stage 2).
VIESSMANN_MOCK=1
OAUTH_REDIRECT_BASE=http://localhost:8080
# Links in e-mails (password reset, invitations). Defaults to OAUTH_REDIRECT_BASE.
PUBLIC_BASE_URL=http://localhost:8080

# --- Data retention (empty = unlimited) ---
RAW_RETENTION_DAYS=

# --- E-mail ---
SMTP_URL=smtp://mailpit:1025
ALERT_EMAIL_OPERATOR=

# --- Control ---
SENSITIVE_COMMANDS=setMode,setSchedule,setCurve,deactivate
